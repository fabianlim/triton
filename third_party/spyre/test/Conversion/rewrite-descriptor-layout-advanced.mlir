// CHECK: #[[$ATTR_0:.+]] = affine_map<(d0, d1, d2) -> (d0, d1, d2)>
// CHECK: #[[$ATTR_1:.+]] = affine_set<(d0, d1, d2) : (d0 >= 0, -d0 + 1 >= 0, d1 >= 0, -d1 + 127 >= 0, d2 >= 0, -d2 + 63 >= 0)>
// CHECK: #[[$ATTR_2:.+]] = affine_set<(d0, d1) : (d0 >= 0, -d0 + 127 >= 0, d1 >= 0, -d1 + 127 >= 0)>
// RUN: spyre-triton-opt %s --lower-descriptor-memory --lower-scalar-load --lower-compute-ops --rewrite-descriptor-layout=data-layout=host | FileCheck %s

// Test: data-layout=host uses logical strides (derived from logical strides via coord map)
// instead of row-major physical strides.
// For [M=128, N=128] stick-on-N with stick_size=64 -> physical [N/64, M, N%64] = [2, 128, 64]:
//   Logical strides: [128, 1]
//   Host-mode physical strides:
//     dim 0 (src=1, floordiv 64): logStride[1]*64 = 1*64 = 64
//     dim 1 (src=0, identity):    logStride[0] = 128
//     dim 2 (src=1, mod 64):      logStride[1] = 1
//   => strides: [64, 128, 1]

module {
// CHECK-LABEL:   tt.func @pointwise_host_layout(
// CHECK-SAME:  %[[VAL_0:.*]]: !tt.ptr<f32>, %[[VAL_1:.*]]: !tt.ptr<f32>) {
// CHECK:           %[[VAL_2:.*]] = arith.constant 0 : i32
// CHECK:           %[[VAL_3:.*]] = builtin.unrealized_conversion_cast %[[VAL_0]] : !tt.ptr<f32> to index
// CHECK:           %[[VAL_4:.*]] = ktdp.construct_memory_view %[[VAL_3]], sizes: [2, 128, 64], strides: [64, 128, 1] {coordinate_set = #[[$ATTR_1]], memory_space = #ktdp.spyre_memory_space<HBM>} : memref<2x128x64xf32>
// CHECK:           %[[VAL_5:.*]] = ktdp.construct_memory_view %[[VAL_3]], sizes: [128, 128], strides: [128, 1] {coordinate_set = #[[$ATTR_2]], memory_space = #ktdp.spyre_memory_space<HBM>} : memref<128x128xf32>
// CHECK:           %[[VAL_6:.*]] = arith.index_cast %[[VAL_2]] : i32 to index
// CHECK:           %[[VAL_7:.*]] = arith.index_cast %[[VAL_2]] : i32 to index
// CHECK:           %[[VAL_8:.*]] = arith.constant 64 : index
// CHECK:           %[[VAL_9:.*]] = arith.divsi %[[VAL_7]], %[[VAL_8]] : index
// CHECK:           %[[VAL_10:.*]] = arith.constant 64 : index
// CHECK:           %[[VAL_11:.*]] = arith.remsi %[[VAL_7]], %[[VAL_10]] : index
// CHECK:           %[[VAL_12:.*]] = ktdp.construct_access_tile %[[VAL_4]]{{\[}}%[[VAL_9]], %[[VAL_6]], %[[VAL_11]]] {access_tile_order = #[[$ATTR_0]], access_tile_set = #[[$ATTR_1]]} : memref<2x128x64xf32> -> !ktdp.access_tile<2x128x64xindex>
// CHECK:           %[[VAL_13:.*]] = ktdp.load %[[VAL_12]] : <2x128x64xindex> -> tensor<2x128x64xf32>
// CHECK:           %[[VAL_14:.*]] = builtin.unrealized_conversion_cast %[[VAL_1]] : !tt.ptr<f32> to index
// CHECK:           %[[VAL_15:.*]] = ktdp.construct_memory_view %[[VAL_14]], sizes: [2, 128, 64], strides: [64, 128, 1] {coordinate_set = #[[$ATTR_1]], memory_space = #ktdp.spyre_memory_space<HBM>} : memref<2x128x64xf32>
// CHECK:           %[[VAL_16:.*]] = ktdp.construct_memory_view %[[VAL_14]], sizes: [128, 128], strides: [128, 1] {coordinate_set = #[[$ATTR_2]], memory_space = #ktdp.spyre_memory_space<HBM>} : memref<128x128xf32>
// CHECK:           %[[VAL_17:.*]] = arith.index_cast %[[VAL_2]] : i32 to index
// CHECK:           %[[VAL_18:.*]] = arith.index_cast %[[VAL_2]] : i32 to index
// CHECK:           %[[VAL_19:.*]] = arith.constant 64 : index
// CHECK:           %[[VAL_20:.*]] = arith.divsi %[[VAL_18]], %[[VAL_19]] : index
// CHECK:           %[[VAL_21:.*]] = arith.constant 64 : index
// CHECK:           %[[VAL_22:.*]] = arith.remsi %[[VAL_18]], %[[VAL_21]] : index
// CHECK:           %[[VAL_23:.*]] = ktdp.construct_access_tile %[[VAL_15]]{{\[}}%[[VAL_20]], %[[VAL_17]], %[[VAL_22]]] {access_tile_order = #[[$ATTR_0]], access_tile_set = #[[$ATTR_1]]} : memref<2x128x64xf32> -> !ktdp.access_tile<2x128x64xindex>
// CHECK:           ktdp.store %[[VAL_13]], %[[VAL_23]] : tensor<2x128x64xf32>, <2x128x64xindex>
// CHECK:           tt.return
// CHECK:         }
tt.func @pointwise_host_layout(%ptr: !tt.ptr<f32>, %out_ptr: !tt.ptr<f32>) {
  %c0_i32 = arith.constant 0 : i32
  %c128_i32 = arith.constant 128 : i32
  %c128_i64 = arith.constant 128 : i64
  %c1_i64 = arith.constant 1 : i64
  // [M=128, N=128] stick-on-N with stick_size=64
  %desc = tt.make_tensor_descriptor %ptr, [%c128_i32, %c128_i32], [%c128_i64, %c1_i64]
      : !tt.ptr<f32>, !tt.tensordesc<128x128xf32>
  tt.spyre_tensor_layout %desc {phys_src = array<i64: 1, 0, 1>, phys_op = array<i64: 1, 0, 2>, phys_arg = array<i64: 64, 0, 64>} : !tt.tensordesc<128x128xf32>
  %d = tt.descriptor_load %desc[%c0_i32, %c0_i32] : !tt.tensordesc<128x128xf32> -> tensor<128x128xf32>
  // Store to physical-annotated output to keep alive.
  %out_desc = tt.make_tensor_descriptor %out_ptr, [%c128_i32, %c128_i32], [%c128_i64, %c1_i64]
      : !tt.ptr<f32>, !tt.tensordesc<128x128xf32>
  tt.spyre_tensor_layout %out_desc {phys_src = array<i64: 1, 0, 1>, phys_op = array<i64: 1, 0, 2>, phys_arg = array<i64: 64, 0, 64>} : !tt.tensordesc<128x128xf32>
  tt.descriptor_store %out_desc[%c0_i32, %c0_i32], %d : !tt.tensordesc<128x128xf32>, tensor<128x128xf32>
  tt.return
}
}
