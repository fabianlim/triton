// CHECK: #[[$ATTR_0:.+]] = affine_map<(d0, d1, d2) -> (d0, d1, d2)>
// CHECK: #[[$ATTR_1:.+]] = affine_map<(d0, d1) -> (d0, d1)>
// CHECK: #[[$ATTR_2:.+]] = affine_map<(d0, d1, d2) -> (d0, d2)>
// CHECK: #[[$ATTR_3:.+]] = affine_set<(d0, d1, d2) : (d0 >= 0, -d0 + 1 >= 0, d1 >= 0, -d1 + 63 >= 0, d2 >= 0, -d2 + 31 >= 0)>
// CHECK: #[[$ATTR_4:.+]] = affine_set<(d0, d1) : (d0 >= 0, -d0 + 1 >= 0, d1 >= 0, -d1 + 31 >= 0)>
// RUN: spyre-triton-opt %s --rewrite-descriptor-layout-generic | FileCheck %s

// A reduce feeding an elementwise, which is where the two numbering rules meet.
//
// The reduced tensor is the unlaid-out value, as in
// rewrite-descriptor-layout-generic-elementwise-chain.mlir -- but here the two
// markers disagree about RANK as well as extent: the input is [M, N] stick-on-N,
// physical rank 3, and the output is the [N] vector, physical rank 2. So the
// projection has to drop the reduced dim, which the elementwise chain never
// exercises.
//
// Two claims land on the one generic, and neither implies the other:
//
//   - the reduction loop sits at the axis it reduces, which is what the
//     scheduler's ReductionLoopExposurePass needs (the -reduce.mlir story);
//   - no operand map composes, which is what dbo-opt's data-transfer size
//     computation needs.
//
// Left logical, the reduced tensor gets `(d0, d1) -> (d0 * 32 + d1)` from the
// sqrt and `(d0, d1, d2) -> (d0 * 32 + d2)` from the reduce, and the second claim
// fails while the first still holds -- which is why they are separate assertions
// rather than one. This is the shape of reduce__one_tile_then_sqrt.

#id2 = affine_map<(d0, d1) -> (d0, d1)>
#id1 = affine_map<(d0) -> (d0)>
#drop0 = affine_map<(d0, d1) -> (d1)>
#s2 = affine_set<(d0, d1) : (d0 >= 0, -d0 + 63 >= 0, d1 >= 0, -d1 + 63 >= 0)>
#s1 = affine_set<(d0) : (d0 >= 0, -d0 + 63 >= 0)>
module {
