// CHECK: #[[$ATTR_0:.+]] = affine_map<(d0, d1) -> (d0, d1)>
// CHECK: #[[$ATTR_1:.+]] = affine_set<(d0, d1) : (d0 >= 0, -d0 + 3 >= 0, d1 >= 0, -d1 + 31 >= 0)>
// RUN: spyre-triton-opt %s --rewrite-descriptor-layout-generic | FileCheck %s

// Chained computes: the value BETWEEN two generics, which no marker mentions.
//
// Both other fixtures in this family cover ONE generic, whose operands are all
// either marked or the accumulator of an unmarked destination. A chain has a
// third kind of value: a fresh tensor.empty that one generic writes and the next
// reads, anchored to no memory at all at this point in the pipeline (the spill
// through HBM happens later, at whatever shape it finds).
//
// Nothing seeds a layout on such a value, and left logical it is addressed
// `(d0, d1) -> (d0 * 32 + d1)` from BOTH sides -- by the producer's `outs` map and
// by the consumer's `ins` map. That composite prints and verifies, which is why no
// fixture caught its absence; dbo-opt rejects it ("unsupported affine expression
// in operand indexing map for data_transfer size computation"). So the layout is
// derived from a neighbour instead, and every map below is a projected
// permutation.
//
// Both functions are the shape of a device fixture that reaches a binary:
// elementwise__1d_device_chain and elementwise__1d_device_chain3.

#id1 = affine_map<(d0) -> (d0)>
#s1 = affine_set<(d0) : (d0 >= 0, -d0 + 127 >= 0)>
module {

// Two computes. The intermediate takes its layout FORWARD, from the marked input
// the first generic reads -- the second's `outs` marker would give the same
// answer, and which of the two wins is not what this pins.
// CHECK-LABEL:   tt.func @chain2(
// CHECK-SAME:  %[[VAL_0:.*]]: !tt.ptr<f32>, %[[VAL_1:.*]]: !tt.ptr<f32>) {
// CHECK:           %[[VAL_2:.*]] = arith.constant 0 : index
// CHECK:           %[[VAL_3:.*]] = builtin.unrealized_conversion_cast %[[VAL_0]] : !tt.ptr<f32> to index
// CHECK:           %[[VAL_4:.*]] = ktdp.construct_memory_view %[[VAL_3]], sizes: [4, 32], strides: [32, 1] {coordinate_set = #[[$ATTR_1]], memory_space = #ktdp.memory_space<global>} : memref<4x32xf32>
// CHECK:           %[[VAL_5:.*]] = arith.constant 32 : index
// CHECK:           %[[VAL_6:.*]] = arith.divsi %[[VAL_2]], %[[VAL_5]] : index
// CHECK:           %[[VAL_7:.*]] = arith.constant 32 : index
// CHECK:           %[[VAL_8:.*]] = arith.remsi %[[VAL_2]], %[[VAL_7]] : index
// CHECK:           %[[VAL_9:.*]] = ktdp.construct_access_tile %[[VAL_4]]{{\[}}%[[VAL_6]], %[[VAL_8]]] {access_tile_order = #[[$ATTR_0]], access_tile_set = #[[$ATTR_1]]} : memref<4x32xf32> -> !ktdp.access_tile<4x32xindex>
// CHECK:           %[[VAL_10:.*]] = ktdp.load %[[VAL_9]] : <4x32xindex> -> tensor<4x32xf32>
// CHECK:           %[[VAL_11:.*]] = builtin.unrealized_conversion_cast %[[VAL_1]] : !tt.ptr<f32> to index
// CHECK:           %[[VAL_12:.*]] = ktdp.construct_memory_view %[[VAL_11]], sizes: [4, 32], strides: [32, 1] {coordinate_set = #[[$ATTR_1]], memory_space = #ktdp.memory_space<global>} : memref<4x32xf32>
// CHECK:           %[[VAL_13:.*]] = arith.constant 32 : index
// CHECK:           %[[VAL_14:.*]] = arith.divsi %[[VAL_2]], %[[VAL_13]] : index
// CHECK:           %[[VAL_15:.*]] = arith.constant 32 : index
// CHECK:           %[[VAL_16:.*]] = arith.remsi %[[VAL_2]], %[[VAL_15]] : index
// CHECK:           %[[VAL_17:.*]] = ktdp.construct_access_tile %[[VAL_12]]{{\[}}%[[VAL_14]], %[[VAL_16]]] {access_tile_order = #[[$ATTR_0]], access_tile_set = #[[$ATTR_1]]} : memref<4x32xf32> -> !ktdp.access_tile<4x32xindex>
// CHECK:           %[[VAL_18:.*]] = tensor.empty() : tensor<4x32xf32>
// CHECK:           %[[VAL_19:.*]] = linalg.generic {indexing_maps = [#[[$ATTR_0]], #[[$ATTR_0]]], iterator_types = ["parallel", "parallel"]} ins(%[[VAL_10]] : tensor<4x32xf32>) outs(%[[VAL_18]] : tensor<4x32xf32>) {
// CHECK:           ^bb0(%[[VAL_20:.*]]: f32, %[[VAL_21:.*]]: f32):
// CHECK:             %[[VAL_22:.*]] = arith.mulf %[[VAL_20]], %[[VAL_20]] : f32
// CHECK:             linalg.yield %[[VAL_22]] : f32
// CHECK:           } -> tensor<4x32xf32>
// CHECK:           %[[VAL_23:.*]] = tensor.empty() : tensor<4x32xf32>
// CHECK:           %[[VAL_24:.*]] = linalg.generic {indexing_maps = [#[[$ATTR_0]], #[[$ATTR_0]]], iterator_types = ["parallel", "parallel"]} ins(%[[VAL_19]] : tensor<4x32xf32>) outs(%[[VAL_23]] : tensor<4x32xf32>) {
// CHECK:           ^bb0(%[[VAL_25:.*]]: f32, %[[VAL_26:.*]]: f32):
// CHECK:             %[[VAL_27:.*]] = arith.addf %[[VAL_25]], %[[VAL_25]] : f32
// CHECK:             linalg.yield %[[VAL_27]] : f32
// CHECK:           } -> tensor<4x32xf32>
// CHECK:           ktdp.store %[[VAL_24]], %[[VAL_17]] : tensor<4x32xf32>, <4x32xindex>
// CHECK:           tt.return
// CHECK:         }
tt.func @chain2(%x: !tt.ptr<f32>, %o: !tt.ptr<f32>) {
  %c0 = arith.constant 0 : index
  %xi = builtin.unrealized_conversion_cast %x : !tt.ptr<f32> to index
  %xv = ktdp.construct_memory_view %xi, sizes: [128], strides: [1] {coordinate_set = #s1, memory_space = #ktdp.memory_space<global>} : memref<128xf32>
  %xd = builtin.unrealized_conversion_cast %xv : memref<128xf32> to !tt.tensordesc<128xf32>
  tt.spyre_tensor_layout %xd {phys_src = array<i64: 0, 0>, phys_op = array<i64: 1, 2>, phys_arg = array<i64: 32, 32>} : <128xf32>
  %xt = ktdp.construct_access_tile %xv[%c0] {access_tile_order = #id1, access_tile_set = #s1} : memref<128xf32> -> !ktdp.access_tile<128xindex>
  %xl = ktdp.load %xt : <128xindex> -> tensor<128xf32>
  %oi = builtin.unrealized_conversion_cast %o : !tt.ptr<f32> to index
  %ov = ktdp.construct_memory_view %oi, sizes: [128], strides: [1] {coordinate_set = #s1, memory_space = #ktdp.memory_space<global>} : memref<128xf32>
  %od = builtin.unrealized_conversion_cast %ov : memref<128xf32> to !tt.tensordesc<128xf32>
  tt.spyre_tensor_layout %od {phys_src = array<i64: 0, 0>, phys_op = array<i64: 1, 2>, phys_arg = array<i64: 32, 32>} : <128xf32>
  %ot = ktdp.construct_access_tile %ov[%c0] {access_tile_order = #id1, access_tile_set = #s1} : memref<128xf32> -> !ktdp.access_tile<128xindex>
  %e0 = tensor.empty() : tensor<128xf32>
  %t = linalg.generic {indexing_maps = [#id1, #id1], iterator_types = ["parallel"]} ins(%xl : tensor<128xf32>) outs(%e0 : tensor<128xf32>) {
  ^bb0(%a: f32, %b: f32):
    %v = arith.mulf %a, %a : f32
    linalg.yield %v : f32
  } -> tensor<128xf32>
  %e1 = tensor.empty() : tensor<128xf32>
  %r = linalg.generic {indexing_maps = [#id1, #id1], iterator_types = ["parallel"]} ins(%t : tensor<128xf32>) outs(%e1 : tensor<128xf32>) {
  ^bb0(%a: f32, %b: f32):
    %v = arith.addf %a, %a : f32
    linalg.yield %v : f32
  } -> tensor<128xf32>
  ktdp.store %r, %ot : tensor<128xf32>, <128xindex>
  tt.return
}

