// CHECK:           %[[VAL_4:.*]] = ktdp.construct_memory_view %[[VAL_3]], sizes: [2, 64, 32], strides: [2048, 32, 1] {coordinate_set = #[[$ATTR_3]], memory_space = #ktdp.memory_space<global>} : memref<2x64x32xf32>
// CHECK:           %[[VAL_5:.*]] = arith.constant 32 : index
