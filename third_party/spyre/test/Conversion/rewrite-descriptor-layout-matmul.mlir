// CHECK: #[[$ATTR_0:.+]] = affine_map<(d0, d1, d2) -> (d0, d1, d2)>
// CHECK: #[[$ATTR_1:.+]] = affine_map<(d0, d1) -> (d0, d1)>
// CHECK: #[[$ATTR_2:.+]] = affine_set<(d0, d1, d2) : (d0 >= 0, -d0 >= 0, d1 >= 0, -d1 + 63 >= 0, d2 >= 0, -d2 + 63 >= 0)>
// CHECK: #[[$ATTR_3:.+]] = affine_set<(d0, d1) : (d0 >= 0, -d0 + 63 >= 0, d1 >= 0, -d1 + 63 >= 0)>
// CHECK: #[[$ATTR_4:.+]] = affine_set<(d0, d1, d2) : (d0 >= 0, -d0 + 1 >= 0, d1 >= 0, -d1 + 63 >= 0, d2 >= 0, -d2 + 63 >= 0)>
// CHECK: #[[$ATTR_5:.+]] = affine_set<(d0, d1) : (d0 >= 0, -d0 + 63 >= 0, d1 >= 0, -d1 + 127 >= 0)>
// CHECK: #[[$ATTR_6:.+]] = affine_set<(d0, d1) : (d0 >= 0, -d0 + 127 >= 0, d1 >= 0, -d1 + 63 >= 0)>
// RUN: spyre-triton-opt %s --lower-descriptor-memory --lower-scalar-load --lower-compute-ops --rewrite-descriptor-layout | FileCheck %s

// Test 1: Single-stick matmul — A[64x64] @ B[64x64] = C[64x64].
// Layout: stick-on-K for A (K=64, stick=64 => 1 K-stick => no loop).
//         stick-on-N for B (N=64, stick=64 => 1 N-stick => no loop).
// Expected: extract_slice of each operand + linalg.matmul, no scf.for.
module {
// CHECK-LABEL:   tt.func @matmul_single_stick(
// CHECK-SAME:      %[[VAL_0:.*]]: !tt.ptr<f32>, %[[VAL_1:.*]]: !tt.ptr<f32>, %[[VAL_2:.*]]: !tt.ptr<f32>) {
// CHECK:             %[[VAL_3:.*]] = arith.constant 0 : i32
// CHECK:             %[[VAL_4:.*]] = builtin.unrealized_conversion_cast %[[VAL_0]] : !tt.ptr<f32> to index
// CHECK:             %[[VAL_5:.*]] = ktdp.construct_memory_view %[[VAL_4]], sizes: [1, 64, 64], strides: [4096, 64, 1] {coordinate_set = #[[$ATTR_2]], memory_space = #ktdp.spyre_memory_space<HBM>} : memref<1x64x64xf32>
// CHECK:             %[[VAL_6:.*]] = ktdp.construct_memory_view %[[VAL_4]], sizes: [64, 64], strides: [64, 1] {coordinate_set = #[[$ATTR_3]], memory_space = #ktdp.spyre_memory_space<HBM>} : memref<64x64xf32>
// CHECK:             %[[VAL_7:.*]] = arith.index_cast %[[VAL_3]] : i32 to index
// CHECK:             %[[VAL_8:.*]] = arith.index_cast %[[VAL_3]] : i32 to index
// CHECK:             %[[VAL_9:.*]] = arith.constant 64 : index
// CHECK:             %[[VAL_10:.*]] = arith.divsi %[[VAL_8]], %[[VAL_9]] : index
// CHECK:             %[[VAL_11:.*]] = arith.constant 64 : index
// CHECK:             %[[VAL_12:.*]] = arith.remsi %[[VAL_8]], %[[VAL_11]] : index
// CHECK:             %[[VAL_13:.*]] = ktdp.construct_access_tile %[[VAL_5]]{{\[}}%[[VAL_10]], %[[VAL_7]], %[[VAL_12]]] {access_tile_order = #[[$ATTR_0]], access_tile_set = #[[$ATTR_2]]} : memref<1x64x64xf32> -> !ktdp.access_tile<1x64x64xindex>
// CHECK:             %[[VAL_14:.*]] = ktdp.load %[[VAL_13]] : <1x64x64xindex> -> tensor<1x64x64xf32>
// CHECK:             %[[VAL_15:.*]] = builtin.unrealized_conversion_cast %[[VAL_1]] : !tt.ptr<f32> to index
// CHECK:             %[[VAL_16:.*]] = ktdp.construct_memory_view %[[VAL_15]], sizes: [1, 64, 64], strides: [4096, 64, 1] {coordinate_set = #[[$ATTR_2]], memory_space = #ktdp.spyre_memory_space<HBM>} : memref<1x64x64xf32>
// CHECK:             %[[VAL_17:.*]] = ktdp.construct_memory_view %[[VAL_15]], sizes: [64, 64], strides: [64, 1] {coordinate_set = #[[$ATTR_3]], memory_space = #ktdp.spyre_memory_space<HBM>} : memref<64x64xf32>
// CHECK:             %[[VAL_18:.*]] = arith.index_cast %[[VAL_3]] : i32 to index
// CHECK:             %[[VAL_19:.*]] = arith.index_cast %[[VAL_3]] : i32 to index
// CHECK:             %[[VAL_20:.*]] = arith.constant 64 : index
// CHECK:             %[[VAL_21:.*]] = arith.divsi %[[VAL_19]], %[[VAL_20]] : index
// CHECK:             %[[VAL_22:.*]] = arith.constant 64 : index
// CHECK:             %[[VAL_23:.*]] = arith.remsi %[[VAL_19]], %[[VAL_22]] : index
// CHECK:             %[[VAL_24:.*]] = ktdp.construct_access_tile %[[VAL_16]]{{\[}}%[[VAL_21]], %[[VAL_18]], %[[VAL_23]]] {access_tile_order = #[[$ATTR_0]], access_tile_set = #[[$ATTR_2]]} : memref<1x64x64xf32> -> !ktdp.access_tile<1x64x64xindex>
// CHECK:             %[[VAL_25:.*]] = ktdp.load %[[VAL_24]] : <1x64x64xindex> -> tensor<1x64x64xf32>
// CHECK:             %[[VAL_26:.*]] = builtin.unrealized_conversion_cast %[[VAL_2]] : !tt.ptr<f32> to index
// CHECK:             %[[VAL_27:.*]] = ktdp.construct_memory_view %[[VAL_26]], sizes: [64, 64], strides: [64, 1] {coordinate_set = #[[$ATTR_3]], memory_space = #ktdp.spyre_memory_space<HBM>} : memref<64x64xf32>
// CHECK:             %[[VAL_28:.*]] = arith.index_cast %[[VAL_3]] : i32 to index
// CHECK:             %[[VAL_29:.*]] = arith.index_cast %[[VAL_3]] : i32 to index
// CHECK:             %[[VAL_30:.*]] = ktdp.construct_access_tile %[[VAL_27]]{{\[}}%[[VAL_28]], %[[VAL_29]]] {access_tile_order = #[[$ATTR_1]], access_tile_set = #[[$ATTR_3]]} : memref<64x64xf32> -> !ktdp.access_tile<64x64xindex>
// CHECK:             %[[VAL_31:.*]] = ktdp.load %[[VAL_30]] : <64x64xindex> -> tensor<64x64xf32>
// CHECK:             %[[VAL_32:.*]] = arith.constant 0 : index
// CHECK:             %[[VAL_33:.*]] = tensor.extract_slice %[[VAL_14]][0, 0, 0] [1, 64, 64] [1, 1, 1] : tensor<1x64x64xf32> to tensor<64x64xf32>
// CHECK:             %[[VAL_34:.*]] = tensor.extract_slice %[[VAL_25]][0, 0, 0] [1, 64, 64] [1, 1, 1] : tensor<1x64x64xf32> to tensor<64x64xf32>
// CHECK:             %[[VAL_35:.*]] = linalg.matmul ins(%[[VAL_33]], %[[VAL_34]] : tensor<64x64xf32>, tensor<64x64xf32>) outs(%[[VAL_31]] : tensor<64x64xf32>) -> tensor<64x64xf32>
// CHECK:             %[[VAL_36:.*]] = arith.index_cast %[[VAL_3]] : i32 to index
// CHECK:             %[[VAL_37:.*]] = arith.index_cast %[[VAL_3]] : i32 to index
// CHECK:             %[[VAL_38:.*]] = ktdp.construct_access_tile %[[VAL_27]]{{\[}}%[[VAL_36]], %[[VAL_37]]] {access_tile_order = #[[$ATTR_1]], access_tile_set = #[[$ATTR_3]]} : memref<64x64xf32> -> !ktdp.access_tile<64x64xindex>
// CHECK:             ktdp.store %[[VAL_35]], %[[VAL_38]] : tensor<64x64xf32>, <64x64xindex>
// CHECK:             tt.return
// CHECK:           }
// CHECK:         }
tt.func @matmul_single_stick(%a_ptr: !tt.ptr<f32>, %b_ptr: !tt.ptr<f32>, %c_ptr: !tt.ptr<f32>) {
  %c0_i32 = arith.constant 0 : i32
  %c64_i32 = arith.constant 64 : i32
  %c64_i64 = arith.constant 64 : i64
  %c1_i64 = arith.constant 1 : i64

  // A[64, 64] stick-on-K(64): phys [1, 64, 64] = [K/64, M, K%64]
  //   phys_src=[1,0,1] phys_op=[1,0,2] phys_arg=[64,0,64]
  %a_desc = tt.make_tensor_descriptor %a_ptr, [%c64_i32, %c64_i32], [%c64_i64, %c1_i64]
      : !tt.ptr<f32>, !tt.tensordesc<64x64xf32>
  tt.spyre_tensor_layout %a_desc {phys_src = array<i64: 1, 0, 1>, phys_op = array<i64: 1, 0, 2>, phys_arg = array<i64: 64, 0, 64>} : !tt.tensordesc<64x64xf32>
  %a = tt.descriptor_load %a_desc[%c0_i32, %c0_i32] : !tt.tensordesc<64x64xf32> -> tensor<64x64xf32>

  // B[64, 64] stick-on-N(64): phys [1, 64, 64] = [N/64, K, N%64]
  //   phys_src=[1,0,1] phys_op=[1,0,2] phys_arg=[64,0,64]
  %b_desc = tt.make_tensor_descriptor %b_ptr, [%c64_i32, %c64_i32], [%c64_i64, %c1_i64]
      : !tt.ptr<f32>, !tt.tensordesc<64x64xf32>
  tt.spyre_tensor_layout %b_desc {phys_src = array<i64: 1, 0, 1>, phys_op = array<i64: 1, 0, 2>, phys_arg = array<i64: 64, 0, 64>} : !tt.tensordesc<64x64xf32>
  %b = tt.descriptor_load %b_desc[%c0_i32, %c0_i32] : !tt.tensordesc<64x64xf32> -> tensor<64x64xf32>

  // C[64, 64] — unannotated accumulator
  %c_desc = tt.make_tensor_descriptor %c_ptr, [%c64_i32, %c64_i32], [%c64_i64, %c1_i64]
      : !tt.ptr<f32>, !tt.tensordesc<64x64xf32>
  %c = tt.descriptor_load %c_desc[%c0_i32, %c0_i32] : !tt.tensordesc<64x64xf32> -> tensor<64x64xf32>

  %d = tt.dot %a, %b, %c : tensor<64x64xf32> * tensor<64x64xf32> -> tensor<64x64xf32>

  tt.descriptor_store %c_desc[%c0_i32, %c0_i32], %d : !tt.tensordesc<64x64xf32>, tensor<64x64xf32>
  tt.return
}
}

// Test 2: K-split matmul — A[64x128] @ B[128x64] = C[64x64].
// Layout: stick-on-K for A (K=128, stick=64 => 2 K-sticks => reduction loop).
//         stick-on-K for B (K=128, stick=64 => 2 K-sticks => reduction loop).
// Expected: scf.for over 2 K-sticks, extract_slice + linalg.matmul inside.
module {
// CHECK-LABEL:   tt.func @matmul_k_split(
// CHECK-SAME:      %[[VAL_0:.*]]: !tt.ptr<f32>, %[[VAL_1:.*]]: !tt.ptr<f32>, %[[VAL_2:.*]]: !tt.ptr<f32>) {
// CHECK:             %[[VAL_3:.*]] = arith.constant 0 : i32
// CHECK:             %[[VAL_4:.*]] = builtin.unrealized_conversion_cast %[[VAL_0]] : !tt.ptr<f32> to index
// CHECK:             %[[VAL_5:.*]] = ktdp.construct_memory_view %[[VAL_4]], sizes: [2, 64, 64], strides: [4096, 64, 1] {coordinate_set = #[[$ATTR_4]], memory_space = #ktdp.spyre_memory_space<HBM>} : memref<2x64x64xf32>
// CHECK:             %[[VAL_6:.*]] = ktdp.construct_memory_view %[[VAL_4]], sizes: [64, 128], strides: [128, 1] {coordinate_set = #[[$ATTR_5]], memory_space = #ktdp.spyre_memory_space<HBM>} : memref<64x128xf32>
// CHECK:             %[[VAL_7:.*]] = arith.index_cast %[[VAL_3]] : i32 to index
// CHECK:             %[[VAL_8:.*]] = arith.index_cast %[[VAL_3]] : i32 to index
// CHECK:             %[[VAL_9:.*]] = arith.constant 64 : index
// CHECK:             %[[VAL_10:.*]] = arith.divsi %[[VAL_8]], %[[VAL_9]] : index
// CHECK:             %[[VAL_11:.*]] = arith.constant 64 : index
// CHECK:             %[[VAL_12:.*]] = arith.remsi %[[VAL_8]], %[[VAL_11]] : index
// CHECK:             %[[VAL_13:.*]] = ktdp.construct_access_tile %[[VAL_5]]{{\[}}%[[VAL_10]], %[[VAL_7]], %[[VAL_12]]] {access_tile_order = #[[$ATTR_0]], access_tile_set = #[[$ATTR_4]]} : memref<2x64x64xf32> -> !ktdp.access_tile<2x64x64xindex>
// CHECK:             %[[VAL_14:.*]] = ktdp.load %[[VAL_13]] : <2x64x64xindex> -> tensor<2x64x64xf32>
// CHECK:             %[[VAL_15:.*]] = builtin.unrealized_conversion_cast %[[VAL_1]] : !tt.ptr<f32> to index
// CHECK:             %[[VAL_16:.*]] = ktdp.construct_memory_view %[[VAL_15]], sizes: [2, 64, 64], strides: [4096, 64, 1] {coordinate_set = #[[$ATTR_4]], memory_space = #ktdp.spyre_memory_space<HBM>} : memref<2x64x64xf32>
// CHECK:             %[[VAL_17:.*]] = ktdp.construct_memory_view %[[VAL_15]], sizes: [128, 64], strides: [64, 1] {coordinate_set = #[[$ATTR_6]], memory_space = #ktdp.spyre_memory_space<HBM>} : memref<128x64xf32>
// CHECK:             %[[VAL_18:.*]] = arith.index_cast %[[VAL_3]] : i32 to index
// CHECK:             %[[VAL_19:.*]] = arith.index_cast %[[VAL_3]] : i32 to index
// CHECK:             %[[VAL_20:.*]] = arith.constant 64 : index
// CHECK:             %[[VAL_21:.*]] = arith.divsi %[[VAL_18]], %[[VAL_20]] : index
// CHECK:             %[[VAL_22:.*]] = arith.constant 64 : index
// CHECK:             %[[VAL_23:.*]] = arith.remsi %[[VAL_18]], %[[VAL_22]] : index
// CHECK:             %[[VAL_24:.*]] = ktdp.construct_access_tile %[[VAL_16]]{{\[}}%[[VAL_21]], %[[VAL_19]], %[[VAL_23]]] {access_tile_order = #[[$ATTR_0]], access_tile_set = #[[$ATTR_4]]} : memref<2x64x64xf32> -> !ktdp.access_tile<2x64x64xindex>
// CHECK:             %[[VAL_25:.*]] = ktdp.load %[[VAL_24]] : <2x64x64xindex> -> tensor<2x64x64xf32>
// CHECK:             %[[VAL_26:.*]] = builtin.unrealized_conversion_cast %[[VAL_2]] : !tt.ptr<f32> to index
// CHECK:             %[[VAL_27:.*]] = ktdp.construct_memory_view %[[VAL_26]], sizes: [64, 64], strides: [64, 1] {coordinate_set = #[[$ATTR_3]], memory_space = #ktdp.spyre_memory_space<HBM>} : memref<64x64xf32>
// CHECK:             %[[VAL_28:.*]] = arith.index_cast %[[VAL_3]] : i32 to index
// CHECK:             %[[VAL_29:.*]] = arith.index_cast %[[VAL_3]] : i32 to index
// CHECK:             %[[VAL_30:.*]] = ktdp.construct_access_tile %[[VAL_27]]{{\[}}%[[VAL_28]], %[[VAL_29]]] {access_tile_order = #[[$ATTR_1]], access_tile_set = #[[$ATTR_3]]} : memref<64x64xf32> -> !ktdp.access_tile<64x64xindex>
// CHECK:             %[[VAL_31:.*]] = ktdp.load %[[VAL_30]] : <64x64xindex> -> tensor<64x64xf32>
// CHECK:             %[[VAL_32:.*]] = arith.constant 0 : index
// CHECK:             %[[VAL_33:.*]] = arith.constant 1 : index
// CHECK:             %[[VAL_34:.*]] = arith.constant 2 : index
// CHECK:             %[[VAL_35:.*]] = scf.for %[[VAL_36:.*]] = %[[VAL_32]] to %[[VAL_34]] step %[[VAL_33]] iter_args(%[[VAL_37:.*]] = %[[VAL_31]]) -> (tensor<64x64xf32>) {
// CHECK:               %[[VAL_38:.*]] = tensor.extract_slice %[[VAL_14]]{{\[}}%[[VAL_36]], 0, 0] [1, 64, 64] [1, 1, 1] : tensor<2x64x64xf32> to tensor<64x64xf32>
// CHECK:               %[[VAL_39:.*]] = tensor.extract_slice %[[VAL_25]]{{\[}}%[[VAL_36]], 0, 0] [1, 64, 64] [1, 1, 1] : tensor<2x64x64xf32> to tensor<64x64xf32>
// CHECK:               %[[VAL_40:.*]] = tensor.empty() : tensor<64x64xf32>
// CHECK:               %[[VAL_41:.*]] = linalg.transpose ins(%[[VAL_39]] : tensor<64x64xf32>) outs(%[[VAL_40]] : tensor<64x64xf32>) permutation = [1, 0]
// CHECK:               %[[VAL_42:.*]] = linalg.matmul ins(%[[VAL_38]], %[[VAL_41]] : tensor<64x64xf32>, tensor<64x64xf32>) outs(%[[VAL_37]] : tensor<64x64xf32>) -> tensor<64x64xf32>
// CHECK:               scf.yield %[[VAL_42]] : tensor<64x64xf32>
// CHECK:             }
// CHECK:             %[[VAL_43:.*]] = arith.index_cast %[[VAL_3]] : i32 to index
// CHECK:             %[[VAL_44:.*]] = arith.index_cast %[[VAL_3]] : i32 to index
// CHECK:             %[[VAL_45:.*]] = ktdp.construct_access_tile %[[VAL_27]]{{\[}}%[[VAL_43]], %[[VAL_44]]] {access_tile_order = #[[$ATTR_1]], access_tile_set = #[[$ATTR_3]]} : memref<64x64xf32> -> !ktdp.access_tile<64x64xindex>
// CHECK:             ktdp.store %[[VAL_35]], %[[VAL_45]] : tensor<64x64xf32>, <64x64xindex>
// CHECK:             tt.return
// CHECK:           }
// CHECK:         }
tt.func @matmul_k_split(%a_ptr: !tt.ptr<f32>, %b_ptr: !tt.ptr<f32>, %c_ptr: !tt.ptr<f32>) {
  %c0_i32 = arith.constant 0 : i32
  %c128_i32 = arith.constant 128 : i32
  %c64_i32 = arith.constant 64 : i32
  %c64_i64 = arith.constant 64 : i64
  %c128_i64 = arith.constant 128 : i64
  %c1_i64 = arith.constant 1 : i64

  // A[64, 128] stick-on-K(64): phys [2, 64, 64] = [K/64, M, K%64]
  //   phys_src=[1,0,1] phys_op=[1,0,2] phys_arg=[64,0,64]
  %a_desc = tt.make_tensor_descriptor %a_ptr, [%c64_i32, %c128_i32], [%c128_i64, %c1_i64]
      : !tt.ptr<f32>, !tt.tensordesc<64x128xf32>
  tt.spyre_tensor_layout %a_desc {phys_src = array<i64: 1, 0, 1>, phys_op = array<i64: 1, 0, 2>, phys_arg = array<i64: 64, 0, 64>} : !tt.tensordesc<64x128xf32>
  %a = tt.descriptor_load %a_desc[%c0_i32, %c0_i32] : !tt.tensordesc<64x128xf32> -> tensor<64x128xf32>

  // B[128, 64] stick-on-K(64): phys [2, 64, 64] = [K/64, N, K%64]
  //   B is [K, N] => K is dim 0. stick-on-K stickifies dim 0.
  //   phys_src=[0,1,0] phys_op=[1,0,2] phys_arg=[64,0,64]
  %b_desc = tt.make_tensor_descriptor %b_ptr, [%c128_i32, %c64_i32], [%c64_i64, %c1_i64]
      : !tt.ptr<f32>, !tt.tensordesc<128x64xf32>
  tt.spyre_tensor_layout %b_desc {phys_src = array<i64: 0, 1, 0>, phys_op = array<i64: 1, 0, 2>, phys_arg = array<i64: 64, 0, 64>} : !tt.tensordesc<128x64xf32>
  %b = tt.descriptor_load %b_desc[%c0_i32, %c0_i32] : !tt.tensordesc<128x64xf32> -> tensor<128x64xf32>

  // C[64, 64] — unannotated accumulator
  %c_desc = tt.make_tensor_descriptor %c_ptr, [%c64_i32, %c64_i32], [%c64_i64, %c1_i64]
      : !tt.ptr<f32>, !tt.tensordesc<64x64xf32>
  %c = tt.descriptor_load %c_desc[%c0_i32, %c0_i32] : !tt.tensordesc<64x64xf32> -> tensor<64x64xf32>

  %d = tt.dot %a, %b, %c : tensor<64x128xf32> * tensor<128x64xf32> -> tensor<64x64xf32>

  tt.descriptor_store %c_desc[%c0_i32, %c0_i32], %d : !tt.tensordesc<64x64xf32>, tensor<64x64xf32>
  tt.return
}
}

// Test 3: Chain matmul — D = A @ (B @ C). The inner matmul B@C produces a
// scratchpad intermediate that the outer matmul consumes directly (no marker).
module {
// CHECK-LABEL:   tt.func @matmul_chain(
// CHECK-SAME:      %[[VAL_0:.*]]: !tt.ptr<f32>, %[[VAL_1:.*]]: !tt.ptr<f32>, %[[VAL_2:.*]]: !tt.ptr<f32>, %[[VAL_3:.*]]: !tt.ptr<f32>) {
// CHECK:             %[[VAL_4:.*]] = arith.constant 0 : i32
// CHECK:             %[[VAL_5:.*]] = builtin.unrealized_conversion_cast %[[VAL_1]] : !tt.ptr<f32> to index
// CHECK:             %[[VAL_6:.*]] = ktdp.construct_memory_view %[[VAL_5]], sizes: [1, 64, 64], strides: [4096, 64, 1] {coordinate_set = #[[$ATTR_2]], memory_space = #ktdp.spyre_memory_space<HBM>} : memref<1x64x64xf32>
// CHECK:             %[[VAL_7:.*]] = ktdp.construct_memory_view %[[VAL_5]], sizes: [64, 64], strides: [64, 1] {coordinate_set = #[[$ATTR_3]], memory_space = #ktdp.spyre_memory_space<HBM>} : memref<64x64xf32>
// CHECK:             %[[VAL_8:.*]] = arith.index_cast %[[VAL_4]] : i32 to index
// CHECK:             %[[VAL_9:.*]] = arith.index_cast %[[VAL_4]] : i32 to index
// CHECK:             %[[VAL_10:.*]] = arith.constant 64 : index
// CHECK:             %[[VAL_11:.*]] = arith.divsi %[[VAL_9]], %[[VAL_10]] : index
// CHECK:             %[[VAL_12:.*]] = arith.constant 64 : index
// CHECK:             %[[VAL_13:.*]] = arith.remsi %[[VAL_9]], %[[VAL_12]] : index
// CHECK:             %[[VAL_14:.*]] = ktdp.construct_access_tile %[[VAL_6]]{{\[}}%[[VAL_11]], %[[VAL_8]], %[[VAL_13]]] {access_tile_order = #[[$ATTR_0]], access_tile_set = #[[$ATTR_2]]} : memref<1x64x64xf32> -> !ktdp.access_tile<1x64x64xindex>
// CHECK:             %[[VAL_15:.*]] = ktdp.load %[[VAL_14]] : <1x64x64xindex> -> tensor<1x64x64xf32>
// CHECK:             %[[VAL_16:.*]] = builtin.unrealized_conversion_cast %[[VAL_2]] : !tt.ptr<f32> to index
// CHECK:             %[[VAL_17:.*]] = ktdp.construct_memory_view %[[VAL_16]], sizes: [1, 64, 64], strides: [4096, 64, 1] {coordinate_set = #[[$ATTR_2]], memory_space = #ktdp.spyre_memory_space<HBM>} : memref<1x64x64xf32>
// CHECK:             %[[VAL_18:.*]] = ktdp.construct_memory_view %[[VAL_16]], sizes: [64, 64], strides: [64, 1] {coordinate_set = #[[$ATTR_3]], memory_space = #ktdp.spyre_memory_space<HBM>} : memref<64x64xf32>
// CHECK:             %[[VAL_19:.*]] = arith.index_cast %[[VAL_4]] : i32 to index
// CHECK:             %[[VAL_20:.*]] = arith.index_cast %[[VAL_4]] : i32 to index
// CHECK:             %[[VAL_21:.*]] = arith.constant 64 : index
// CHECK:             %[[VAL_22:.*]] = arith.divsi %[[VAL_20]], %[[VAL_21]] : index
// CHECK:             %[[VAL_23:.*]] = arith.constant 64 : index
// CHECK:             %[[VAL_24:.*]] = arith.remsi %[[VAL_20]], %[[VAL_23]] : index
// CHECK:             %[[VAL_25:.*]] = ktdp.construct_access_tile %[[VAL_17]]{{\[}}%[[VAL_22]], %[[VAL_19]], %[[VAL_24]]] {access_tile_order = #[[$ATTR_0]], access_tile_set = #[[$ATTR_2]]} : memref<1x64x64xf32> -> !ktdp.access_tile<1x64x64xindex>
// CHECK:             %[[VAL_26:.*]] = ktdp.load %[[VAL_25]] : <1x64x64xindex> -> tensor<1x64x64xf32>
// CHECK:             %[[VAL_27:.*]] = arith.constant dense<0.000000e+00> : tensor<64x64xf32>
// CHECK:             %[[VAL_28:.*]] = arith.constant 0 : index
// CHECK:             %[[VAL_29:.*]] = tensor.extract_slice %[[VAL_15]][0, 0, 0] [1, 64, 64] [1, 1, 1] : tensor<1x64x64xf32> to tensor<64x64xf32>
// CHECK:             %[[VAL_30:.*]] = tensor.extract_slice %[[VAL_26]][0, 0, 0] [1, 64, 64] [1, 1, 1] : tensor<1x64x64xf32> to tensor<64x64xf32>
// CHECK:             %[[VAL_31:.*]] = linalg.matmul ins(%[[VAL_29]], %[[VAL_30]] : tensor<64x64xf32>, tensor<64x64xf32>) outs(%[[VAL_27]] : tensor<64x64xf32>) -> tensor<64x64xf32>
// CHECK:             %[[VAL_32:.*]] = builtin.unrealized_conversion_cast %[[VAL_0]] : !tt.ptr<f32> to index
// CHECK:             %[[VAL_33:.*]] = ktdp.construct_memory_view %[[VAL_32]], sizes: [1, 64, 64], strides: [4096, 64, 1] {coordinate_set = #[[$ATTR_2]], memory_space = #ktdp.spyre_memory_space<HBM>} : memref<1x64x64xf32>
// CHECK:             %[[VAL_34:.*]] = ktdp.construct_memory_view %[[VAL_32]], sizes: [64, 64], strides: [64, 1] {coordinate_set = #[[$ATTR_3]], memory_space = #ktdp.spyre_memory_space<HBM>} : memref<64x64xf32>
// CHECK:             %[[VAL_35:.*]] = arith.index_cast %[[VAL_4]] : i32 to index
// CHECK:             %[[VAL_36:.*]] = arith.index_cast %[[VAL_4]] : i32 to index
// CHECK:             %[[VAL_37:.*]] = arith.constant 64 : index
// CHECK:             %[[VAL_38:.*]] = arith.divsi %[[VAL_36]], %[[VAL_37]] : index
// CHECK:             %[[VAL_39:.*]] = arith.constant 64 : index
// CHECK:             %[[VAL_40:.*]] = arith.remsi %[[VAL_36]], %[[VAL_39]] : index
// CHECK:             %[[VAL_41:.*]] = ktdp.construct_access_tile %[[VAL_33]]{{\[}}%[[VAL_38]], %[[VAL_35]], %[[VAL_40]]] {access_tile_order = #[[$ATTR_0]], access_tile_set = #[[$ATTR_2]]} : memref<1x64x64xf32> -> !ktdp.access_tile<1x64x64xindex>
// CHECK:             %[[VAL_42:.*]] = ktdp.load %[[VAL_41]] : <1x64x64xindex> -> tensor<1x64x64xf32>
// CHECK:             %[[VAL_43:.*]] = arith.constant dense<0.000000e+00> : tensor<64x64xf32>
// CHECK:             %[[VAL_44:.*]] = arith.constant 0 : index
// CHECK:             %[[VAL_45:.*]] = tensor.extract_slice %[[VAL_42]][0, 0, 0] [1, 64, 64] [1, 1, 1] : tensor<1x64x64xf32> to tensor<64x64xf32>
// CHECK:             %[[VAL_46:.*]] = tensor.extract_slice %[[VAL_31]][0, 0] [64, 64] [1, 1] : tensor<64x64xf32> to tensor<64x64xf32>
// CHECK:             %[[VAL_47:.*]] = linalg.matmul ins(%[[VAL_45]], %[[VAL_46]] : tensor<64x64xf32>, tensor<64x64xf32>) outs(%[[VAL_43]] : tensor<64x64xf32>) -> tensor<64x64xf32>
// CHECK:             %[[VAL_48:.*]] = builtin.unrealized_conversion_cast %[[VAL_3]] : !tt.ptr<f32> to index
// CHECK:             %[[VAL_49:.*]] = ktdp.construct_memory_view %[[VAL_48]], sizes: [64, 64], strides: [64, 1] {coordinate_set = #[[$ATTR_3]], memory_space = #ktdp.spyre_memory_space<HBM>} : memref<64x64xf32>
// CHECK:             %[[VAL_50:.*]] = arith.index_cast %[[VAL_4]] : i32 to index
// CHECK:             %[[VAL_51:.*]] = arith.index_cast %[[VAL_4]] : i32 to index
// CHECK:             %[[VAL_52:.*]] = ktdp.construct_access_tile %[[VAL_49]]{{\[}}%[[VAL_50]], %[[VAL_51]]] {access_tile_order = #[[$ATTR_1]], access_tile_set = #[[$ATTR_3]]} : memref<64x64xf32> -> !ktdp.access_tile<64x64xindex>
// CHECK:             ktdp.store %[[VAL_47]], %[[VAL_52]] : tensor<64x64xf32>, <64x64xindex>
// CHECK:             tt.return
// CHECK:           }
// CHECK:         }
tt.func @matmul_chain(%a_ptr: !tt.ptr<f32>, %b_ptr: !tt.ptr<f32>, %c_ptr: !tt.ptr<f32>, %d_ptr: !tt.ptr<f32>) {
  %c0_i32 = arith.constant 0 : i32
  %c64_i32 = arith.constant 64 : i32
  %c64_i64 = arith.constant 64 : i64
  %c1_i64 = arith.constant 1 : i64

  // B[64, 64] stick-on-N(64): phys [1, 64, 64] = [N/64, K, N%64]
  %b_desc = tt.make_tensor_descriptor %b_ptr, [%c64_i32, %c64_i32], [%c64_i64, %c1_i64]
      : !tt.ptr<f32>, !tt.tensordesc<64x64xf32>
  tt.spyre_tensor_layout %b_desc {phys_src = array<i64: 1, 0, 1>, phys_op = array<i64: 1, 0, 2>, phys_arg = array<i64: 64, 0, 64>} : !tt.tensordesc<64x64xf32>
  %b = tt.descriptor_load %b_desc[%c0_i32, %c0_i32] : !tt.tensordesc<64x64xf32> -> tensor<64x64xf32>

  // C[64, 64] stick-on-N(64): phys [1, 64, 64] = [N/64, K, N%64]
  %c_desc = tt.make_tensor_descriptor %c_ptr, [%c64_i32, %c64_i32], [%c64_i64, %c1_i64]
      : !tt.ptr<f32>, !tt.tensordesc<64x64xf32>
  tt.spyre_tensor_layout %c_desc {phys_src = array<i64: 1, 0, 1>, phys_op = array<i64: 1, 0, 2>, phys_arg = array<i64: 64, 0, 64>} : !tt.tensordesc<64x64xf32>
  %c = tt.descriptor_load %c_desc[%c0_i32, %c0_i32] : !tt.tensordesc<64x64xf32> -> tensor<64x64xf32>

  // B@C init: zero tensor [64, 64]
  %zero = arith.constant dense<0.0> : tensor<64x64xf32>
  %bc = tt.dot %b, %c, %zero : tensor<64x64xf32> * tensor<64x64xf32> -> tensor<64x64xf32>

  // A[64, 64] stick-on-K(64): phys [1, 64, 64] = [K/64, M, K%64]
  %a_desc = tt.make_tensor_descriptor %a_ptr, [%c64_i32, %c64_i32], [%c64_i64, %c1_i64]
      : !tt.ptr<f32>, !tt.tensordesc<64x64xf32>
  tt.spyre_tensor_layout %a_desc {phys_src = array<i64: 1, 0, 1>, phys_op = array<i64: 1, 0, 2>, phys_arg = array<i64: 64, 0, 64>} : !tt.tensordesc<64x64xf32>
  %a = tt.descriptor_load %a_desc[%c0_i32, %c0_i32] : !tt.tensordesc<64x64xf32> -> tensor<64x64xf32>

  // D = A @ BC (BC is a scratchpad — no marker)
  %d_init = arith.constant dense<0.0> : tensor<64x64xf32>
  %d = tt.dot %a, %bc, %d_init : tensor<64x64xf32> * tensor<64x64xf32> -> tensor<64x64xf32>

  %d_desc = tt.make_tensor_descriptor %d_ptr, [%c64_i32, %c64_i32], [%c64_i64, %c1_i64]
      : !tt.ptr<f32>, !tt.tensordesc<64x64xf32>
  tt.descriptor_store %d_desc[%c0_i32, %c0_i32], %d : !tt.tensordesc<64x64xf32>, tensor<64x64xf32>
  tt.return
}
}
// Test 4: A stick-on-M, B stick-on-N (both parallel, trip=1 each).
// A[64x128] stick-on-M(64): phys [M/64, K, M%64] = [1, 128, 64]
// B[128x64] stick-on-N(64): phys [N/64, K, N%64] = [1, 128, 64]
// C unannotated [64x64].
// Expected: no scf.for (trip=1 inlined), linalg.transpose on A, no transpose on B.
module {
// CHECK-LABEL:   tt.func @matmul_both_parallel(
// CHECK-SAME:      %[[VAL_0:.*]]: !tt.ptr<f32>, %[[VAL_1:.*]]: !tt.ptr<f32>, %[[VAL_2:.*]]: !tt.ptr<f32>) {
// CHECK:             %[[A_PHYS:.*]] = ktdp.construct_memory_view %{{.*}}, sizes: [1, 128, 64], strides: [8192, 64, 1] {{.*}} : memref<1x128x64xf32>
// CHECK:             %[[A_LOADED:.*]] = ktdp.load %{{.*}} : <1x128x64xindex> -> tensor<1x128x64xf32>
// CHECK:             %[[B_PHYS:.*]] = ktdp.construct_memory_view %{{.*}}, sizes: [1, 128, 64], strides: [8192, 64, 1] {{.*}} : memref<1x128x64xf32>
// CHECK:             %[[B_LOADED:.*]] = ktdp.load %{{.*}} : <1x128x64xindex> -> tensor<1x128x64xf32>
// CHECK:             %[[C_LOADED:.*]] = ktdp.load %{{.*}} : <64x64xindex> -> tensor<64x64xf32>
// CHECK:             tensor.extract_slice %[[A_LOADED]]
// CHECK:             linalg.transpose
// CHECK:             tensor.extract_slice %[[B_LOADED]]
// CHECK:             linalg.matmul
// CHECK-NOT:         scf.for
// CHECK:             ktdp.store
// CHECK:             tt.return
// CHECK:           }
tt.func @matmul_both_parallel(%a_ptr: !tt.ptr<f32>, %b_ptr: !tt.ptr<f32>, %c_ptr: !tt.ptr<f32>) {
  %c0_i32 = arith.constant 0 : i32
  %c64_i32 = arith.constant 64 : i32
  %c128_i32 = arith.constant 128 : i32
  %c128_i64 = arith.constant 128 : i64
  %c64_i64 = arith.constant 64 : i64
  %c1_i64 = arith.constant 1 : i64
  // A[M=64, K=128] stick-on-M(64): phys [M/64, K, M%64] = [1, 128, 64]
  %a_desc = tt.make_tensor_descriptor %a_ptr, [%c64_i32, %c128_i32], [%c128_i64, %c1_i64]
      : !tt.ptr<f32>, !tt.tensordesc<64x128xf32>
  tt.spyre_tensor_layout %a_desc {phys_src = array<i64: 0, 1, 0>, phys_op = array<i64: 1, 0, 2>, phys_arg = array<i64: 64, 0, 64>} : !tt.tensordesc<64x128xf32>
  %a = tt.descriptor_load %a_desc[%c0_i32, %c0_i32] : !tt.tensordesc<64x128xf32> -> tensor<64x128xf32>
  // B[K=128, N=64] stick-on-N(64): phys [N/64, K, N%64] = [1, 128, 64]
  %b_desc = tt.make_tensor_descriptor %b_ptr, [%c128_i32, %c64_i32], [%c64_i64, %c1_i64]
      : !tt.ptr<f32>, !tt.tensordesc<128x64xf32>
  tt.spyre_tensor_layout %b_desc {phys_src = array<i64: 1, 0, 1>, phys_op = array<i64: 1, 0, 2>, phys_arg = array<i64: 64, 0, 64>} : !tt.tensordesc<128x64xf32>
  %b = tt.descriptor_load %b_desc[%c0_i32, %c0_i32] : !tt.tensordesc<128x64xf32> -> tensor<128x64xf32>
  // C unannotated [64x64]
  %c_desc = tt.make_tensor_descriptor %c_ptr, [%c64_i32, %c64_i32], [%c64_i64, %c1_i64]
      : !tt.ptr<f32>, !tt.tensordesc<64x64xf32>
  %c = tt.descriptor_load %c_desc[%c0_i32, %c0_i32] : !tt.tensordesc<64x64xf32> -> tensor<64x64xf32>
  %d = tt.dot %a, %b, %c : tensor<64x128xf32> * tensor<128x64xf32> -> tensor<64x64xf32>
  tt.descriptor_store %c_desc[%c0_i32, %c0_i32], %d : !tt.tensordesc<64x64xf32>, tensor<64x64xf32>
  tt.return
}
}

// -----
// Test 5: A stick-on-K(64) with K=128, B stick-on-K(64) with K=128.
// Both contribute sticks to the K-reduction axis.
// A[64x128] stick-on-K(64): phys [K/64, M, K%64] = [2, 64, 64]
//   phys_src=[1,0,1] phys_op=[floordiv,id,mod] phys_arg=[64,0,64]
// B[128x64] stick-on-K(64): phys [K/64, N, K%64] = [2, 64, 64]
//   phys_src=[0,1,0] phys_op=[floordiv,id,mod] phys_arg=[64,0,64]
// C unannotated.
// Expected: scf.for over 2 K-sticks, linalg.transpose on B, linalg.matmul inside loop.
// CHECK-LABEL:   tt.func @matmul_both_k_split(
// CHECK-SAME:      %[[VAL_0:.*]]: !tt.ptr<f32>, %[[VAL_1:.*]]: !tt.ptr<f32>, %[[VAL_2:.*]]: !tt.ptr<f32>) {
// CHECK:             %[[A_PHYS:.*]] = ktdp.construct_memory_view %{{.*}}, sizes: [2, 64, 64], strides: [4096, 64, 1] {{.*}} : memref<2x64x64xf32>
// CHECK:             %[[A_LOADED:.*]] = ktdp.load %{{.*}} : <2x64x64xindex> -> tensor<2x64x64xf32>
// CHECK:             %[[B_PHYS:.*]] = ktdp.construct_memory_view %{{.*}}, sizes: [2, 64, 64], strides: [4096, 64, 1] {{.*}} : memref<2x64x64xf32>
// CHECK:             %[[B_LOADED:.*]] = ktdp.load %{{.*}} : <2x64x64xindex> -> tensor<2x64x64xf32>
// CHECK:             %[[C_LOADED:.*]] = ktdp.load %{{.*}} : <64x64xindex> -> tensor<64x64xf32>
// CHECK:             %[[C0:.*]] = arith.constant 0 : index
// CHECK:             %[[C1:.*]] = arith.constant 1 : index
// CHECK:             %[[C2:.*]] = arith.constant 2 : index
// CHECK:             %[[LOOP:.*]] = scf.for %[[IV:.*]] = %[[C0]] to %[[C2]] step %[[C1]] iter_args(%[[ACC:.*]] = %[[C_LOADED]]) -> (tensor<64x64xf32>) {
// CHECK:               %[[A_SLICE:.*]] = tensor.extract_slice %[[A_LOADED]][%[[IV]], 0, 0] [1, 64, 64] [1, 1, 1] : tensor<2x64x64xf32> to tensor<64x64xf32>
// CHECK:               %[[B_SLICE:.*]] = tensor.extract_slice %[[B_LOADED]][%[[IV]], 0, 0] [1, 64, 64] [1, 1, 1] : tensor<2x64x64xf32> to tensor<64x64xf32>
// CHECK:               %[[B_EMPTY:.*]] = tensor.empty() : tensor<64x64xf32>
// CHECK:               %[[B_T:.*]] = linalg.transpose ins(%[[B_SLICE]] : tensor<64x64xf32>) outs(%[[B_EMPTY]] : tensor<64x64xf32>) permutation = [1, 0]
// CHECK:               %[[MM:.*]] = linalg.matmul ins(%[[A_SLICE]], %[[B_T]] : tensor<64x64xf32>, tensor<64x64xf32>) outs(%[[ACC]] : tensor<64x64xf32>) -> tensor<64x64xf32>
// CHECK:               scf.yield %[[MM]] : tensor<64x64xf32>
// CHECK:             }
// CHECK:             ktdp.store %[[LOOP]], %{{.*}} : tensor<64x64xf32>, <64x64xindex>
// CHECK:             tt.return
// CHECK:           }
module {
tt.func @matmul_both_k_split(%a_ptr: !tt.ptr<f32>, %b_ptr: !tt.ptr<f32>, %c_ptr: !tt.ptr<f32>) {
  %c0_i32 = arith.constant 0 : i32
  %c64_i32 = arith.constant 64 : i32
  %c128_i32 = arith.constant 128 : i32
  %c128_i64 = arith.constant 128 : i64
  %c64_i64 = arith.constant 64 : i64
  %c1_i64 = arith.constant 1 : i64
  // A[M=64, K=128] stick-on-K: phys [K/64, M, K%64] = [2, 64, 64]
  %a_desc = tt.make_tensor_descriptor %a_ptr, [%c64_i32, %c128_i32], [%c128_i64, %c1_i64]
      : !tt.ptr<f32>, !tt.tensordesc<64x128xf32>
  tt.spyre_tensor_layout %a_desc {phys_src = array<i64: 1, 0, 1>, phys_op = array<i64: 1, 0, 2>, phys_arg = array<i64: 64, 0, 64>} : !tt.tensordesc<64x128xf32>
  %a = tt.descriptor_load %a_desc[%c0_i32, %c0_i32] : !tt.tensordesc<64x128xf32> -> tensor<64x128xf32>
  // B[K=128, N=64] stick-on-K: phys [K/64, N, K%64] = [2, 64, 64]
  %b_desc = tt.make_tensor_descriptor %b_ptr, [%c128_i32, %c64_i32], [%c64_i64, %c1_i64]
      : !tt.ptr<f32>, !tt.tensordesc<128x64xf32>
  tt.spyre_tensor_layout %b_desc {phys_src = array<i64: 0, 1, 0>, phys_op = array<i64: 1, 0, 2>, phys_arg = array<i64: 64, 0, 64>} : !tt.tensordesc<128x64xf32>
  %b = tt.descriptor_load %b_desc[%c0_i32, %c0_i32] : !tt.tensordesc<128x64xf32> -> tensor<128x64xf32>
  // C unannotated
  %c_desc = tt.make_tensor_descriptor %c_ptr, [%c64_i32, %c64_i32], [%c64_i64, %c1_i64]
      : !tt.ptr<f32>, !tt.tensordesc<64x64xf32>
  %c = tt.descriptor_load %c_desc[%c0_i32, %c0_i32] : !tt.tensordesc<64x64xf32> -> tensor<64x64xf32>
  %d = tt.dot %a, %b, %c : tensor<64x128xf32> * tensor<128x64xf32> -> tensor<64x64xf32>
  tt.descriptor_store %c_desc[%c0_i32, %c0_i32], %d : !tt.tensordesc<64x64xf32>, tensor<64x64xf32>
  tt.return
}
}

// -----
// Test 6: A stick-on-M (trip=1), B stick-on-K (trip=2) — parallel on A, reduction on B.
// A[64x128] stick-on-M(64): phys [M/64, K, M%64] = [1, 128, 64]
// B[128x64] stick-on-K(64): phys [K/64, N, K%64] = [2, 64, 64]
// C unannotated [64x64].
// Expected: scf.for over 2 K-sticks, linalg.transpose on both A and B slices,
//           linalg.matmul inside loop.
// CHECK-LABEL:   tt.func @matmul_a_parallel_b_ksplit(
// CHECK-SAME:      %[[VAL_0:.*]]: !tt.ptr<f32>, %[[VAL_1:.*]]: !tt.ptr<f32>, %[[VAL_2:.*]]: !tt.ptr<f32>) {
// CHECK:             %[[A_PHYS:.*]] = ktdp.construct_memory_view %{{.*}}, sizes: [1, 128, 64], strides: [8192, 64, 1] {{.*}} : memref<1x128x64xf32>
// CHECK:             %[[A_LOADED:.*]] = ktdp.load %{{.*}} : <1x128x64xindex> -> tensor<1x128x64xf32>
// CHECK:             %[[B_PHYS:.*]] = ktdp.construct_memory_view %{{.*}}, sizes: [2, 64, 64], strides: [4096, 64, 1] {{.*}} : memref<2x64x64xf32>
// CHECK:             %[[B_LOADED:.*]] = ktdp.load %{{.*}} : <2x64x64xindex> -> tensor<2x64x64xf32>
// CHECK:             %[[C_LOADED:.*]] = ktdp.load %{{.*}} : <64x64xindex> -> tensor<64x64xf32>
// CHECK:             scf.for
// CHECK:               tensor.extract_slice %[[A_LOADED]]
// CHECK:               linalg.transpose
// CHECK:               tensor.extract_slice %[[B_LOADED]]
// CHECK:               linalg.transpose
// CHECK:               linalg.matmul
// CHECK:               scf.yield
// CHECK:             }
// CHECK:             ktdp.store
// CHECK:             tt.return
// CHECK:           }
module {
tt.func @matmul_a_parallel_b_ksplit(%a_ptr: !tt.ptr<f32>, %b_ptr: !tt.ptr<f32>, %c_ptr: !tt.ptr<f32>) {
  %c0_i32 = arith.constant 0 : i32
  %c64_i32 = arith.constant 64 : i32
  %c128_i32 = arith.constant 128 : i32
  %c128_i64 = arith.constant 128 : i64
  %c64_i64 = arith.constant 64 : i64
  %c1_i64 = arith.constant 1 : i64
  // A[M=64, K=128] stick-on-M(64): phys [M/64, K, M%64] = [1, 128, 64]
  %a_desc = tt.make_tensor_descriptor %a_ptr, [%c64_i32, %c128_i32], [%c128_i64, %c1_i64]
      : !tt.ptr<f32>, !tt.tensordesc<64x128xf32>
  tt.spyre_tensor_layout %a_desc {phys_src = array<i64: 0, 1, 0>, phys_op = array<i64: 1, 0, 2>, phys_arg = array<i64: 64, 0, 64>} : !tt.tensordesc<64x128xf32>
  %a = tt.descriptor_load %a_desc[%c0_i32, %c0_i32] : !tt.tensordesc<64x128xf32> -> tensor<64x128xf32>
  // B[K=128, N=64] stick-on-K(64): phys [K/64, N, K%64] = [2, 64, 64]
  %b_desc = tt.make_tensor_descriptor %b_ptr, [%c128_i32, %c64_i32], [%c64_i64, %c1_i64]
      : !tt.ptr<f32>, !tt.tensordesc<128x64xf32>
  tt.spyre_tensor_layout %b_desc {phys_src = array<i64: 0, 1, 0>, phys_op = array<i64: 1, 0, 2>, phys_arg = array<i64: 64, 0, 64>} : !tt.tensordesc<128x64xf32>
  %b = tt.descriptor_load %b_desc[%c0_i32, %c0_i32] : !tt.tensordesc<128x64xf32> -> tensor<128x64xf32>
  // C unannotated [64x64]
  %c_desc = tt.make_tensor_descriptor %c_ptr, [%c64_i32, %c64_i32], [%c64_i64, %c1_i64]
      : !tt.ptr<f32>, !tt.tensordesc<64x64xf32>
  %c = tt.descriptor_load %c_desc[%c0_i32, %c0_i32] : !tt.tensordesc<64x64xf32> -> tensor<64x64xf32>
  %d = tt.dot %a, %b, %c : tensor<64x128xf32> * tensor<128x64xf32> -> tensor<64x64xf32>
  tt.descriptor_store %c_desc[%c0_i32, %c0_i32], %d : !tt.tensordesc<64x64xf32>, tensor<64x64xf32>
  tt.return
}
}
